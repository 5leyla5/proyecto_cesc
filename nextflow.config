executor {
    queueSize = 1
}

process {

    executor = 'local'

    withName: FASTQC {
        cpus = 2
        memory = '1 GB'
    }

    withName: BWA_MEM2 {
        cpus = 1
        memory = '9 GB'
    }

    withName: SAMTOOLS_INDEX {
        cpus = 1
        memory = '1 GB'
    }

    withName: MARK_DUPLICATES {
        cpus = 2
        memory = '4 GB'
    }

    withName: MUTECT2 {
        cpus = 2
        memory = '9 GB'
    }

    withName: FILTER_MUTECT_CALLS {
        cpus = 1
        memory = '6 GB'
    }

    withName: SNPEFF {
        cpus = 1
        memory = '9 GB'
    }
}